APP_NAME=network-agent-rag
ENVIRONMENT=development
API_PREFIX=/api/v1
NETWORK_AGENT_API_URL=http://127.0.0.1:8000
CHECKPOINT_DB_PATH=data/enterprise/checkpoints.sqlite3
AUDIT_DB_PATH=data/enterprise/audit.sqlite3
OBSERVABILITY_DB_PATH=data/enterprise/observability.sqlite3
BENCHMARK_RESULTS_PATH=data/evaluations
APPROVAL_TTL_SECONDS=1800
LANGGRAPH_STRICT_MSGPACK=true
STORAGE_BACKEND=sqlite
CHECKPOINT_BACKEND=sqlite
DATABASE_URL=postgresql://networkops:networkops@127.0.0.1:5432/networkops
REDIS_URL=redis://:networkops@127.0.0.1:6379/0

# Leave empty to preserve legacy local mode. Set at least 32 random bytes to enable JWT.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Local docker-compose development credentials only. Replace before shared use.
POSTGRES_USER=networkops
POSTGRES_PASSWORD=networkops
POSTGRES_DB=networkops
REDIS_PASSWORD=networkops
