APP_NAME=network-agent-rag
APP_ENV=development
API_PREFIX=/api/v1
NETWORK_AGENT_API_URL=http://127.0.0.1:8000

CHECKPOINT_DB_PATH=data/enterprise/checkpoints.sqlite3
AUDIT_DB_PATH=data/enterprise/audit.sqlite3
OBSERVABILITY_DB_PATH=data/enterprise/observability.sqlite3
BENCHMARK_RESULTS_PATH=data/evaluations
APPROVAL_TTL_SECONDS=1800
LANGGRAPH_STRICT_MSGPACK=true

# Development defaults. Production validation requires postgres + redis.
STORAGE_BACKEND=sqlite
CHECKPOINT_BACKEND=sqlite
DATABASE_URL=
REDIS_URL=

# Deployment adapter. Provide a trusted importable module:function.
NETWORKOPS_WORKFLOW_FACTORY=
PROMETHEUS_ENABLED=false

# Leave empty to preserve legacy local mode. Use at least 32 random bytes in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Required by docker-compose; never commit populated values.
POSTGRES_USER=networkops
POSTGRES_PASSWORD=
POSTGRES_DB=networkops
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
NETWORKOPS_GATEWAY_PORT=8080
GRAFANA_PORT=3000
